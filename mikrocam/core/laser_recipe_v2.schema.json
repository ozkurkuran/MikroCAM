{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikrocam.example/schemas/laser-recipe-v2",
  "title": "Device-aware MikroCAM laser recipe v2",
  "type": "object",
  "properties": {
    "kind": {
      "const": "mikrocam.laser-recipe"
    },
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "diode",
            "co2",
            "ruida_rf_co2",
            "fiber",
            "mopa",
            "uv"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frequency_range_khz": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "pulse_width_range_ns": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "pulse_widths_ns": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "pwm_frequency_range_khz": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "frequency_range_khz",
        "pulse_width_range_ns",
        "pulse_widths_ns",
        "pwm_frequency_range_khz"
      ]
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "power_percent": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "speed_mm_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "frequency_khz": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "pulse_width_ns": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "min_power_percent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "pwm_frequency_khz": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "power_percent",
          "speed_mm_s",
          "frequency_khz",
          "pulse_width_ns",
          "min_power_percent",
          "pwm_frequency_khz"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "name",
    "device",
    "passes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "diode"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "type": "number"
                },
                "frequency_khz": {
                  "const": null
                },
                "pulse_width_ns": {
                  "const": null
                },
                "min_power_percent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pwm_frequency_khz": {
                  "const": null
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "co2"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "type": "number"
                },
                "frequency_khz": {
                  "const": null
                },
                "pulse_width_ns": {
                  "const": null
                },
                "min_power_percent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pwm_frequency_khz": {
                  "const": null
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "ruida_rf_co2"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "type": "number"
                },
                "frequency_khz": {
                  "const": null
                },
                "pulse_width_ns": {
                  "const": null
                },
                "min_power_percent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pwm_frequency_khz": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "fiber"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "type": "number"
                },
                "frequency_khz": {
                  "type": "number"
                },
                "pulse_width_ns": {
                  "const": null
                },
                "min_power_percent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pwm_frequency_khz": {
                  "const": null
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "mopa"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "type": "number"
                },
                "frequency_khz": {
                  "type": "number"
                },
                "pulse_width_ns": {
                  "type": "number"
                },
                "min_power_percent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pwm_frequency_khz": {
                  "const": null
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "uv"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "passes": {
            "items": {
              "properties": {
                "power_percent": {
                  "const": null
                },
                "frequency_khz": {
                  "type": "number"
                },
                "pulse_width_ns": {
                  "type": "number"
                },
                "min_power_percent": {
                  "const": null
                },
                "pwm_frequency_khz": {
                  "const": null
                }
              }
            }
          }
        }
      }
    }
  ]
}
