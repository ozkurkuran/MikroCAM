{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikrocam.example/schemas/laser-recipe-db-v1",
  "title": "MikroCAM laser recipe database v1",
  "description": "Materials, lenses, machines (device profiles stored once) and recipes. Recipes without machine_id use the schema-1 pass fields; recipes with machine_id use the seven schema-2 pass fields with null for inapplicable values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "materials", "lenses", "machines", "recipes"],
  "properties": {
    "kind": {"const": "mikrocam.laser-recipe-db"},
    "schema_version": {"const": 1},
    "materials": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "thickness_mm", "notes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/name"},
          "thickness_mm": {"$ref": "#/$defs/optionalLength"},
          "notes": {"$ref": "#/$defs/notes"}
        }
      }
    },
    "lenses": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "focal_length_mm", "notes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/name"},
          "focal_length_mm": {"$ref": "#/$defs/optionalLength"},
          "notes": {"$ref": "#/$defs/notes"}
        }
      }
    },
    "machines": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "device", "notes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "device": {"description": "Laser device profile exactly as in laser-recipe-v2 device.", "type": "object"},
          "notes": {"$ref": "#/$defs/notes"}
        }
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "machine_id", "material_id", "lens_id", "notes", "passes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/name"},
          "machine_id": {"$ref": "#/$defs/optionalId"},
          "material_id": {"$ref": "#/$defs/optionalId"},
          "lens_id": {"$ref": "#/$defs/optionalId"},
          "notes": {"$ref": "#/$defs/notes"},
          "passes": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "optionalId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "notes": {"type": "string", "maxLength": 4000},
    "optionalLength": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]}
  }
}
